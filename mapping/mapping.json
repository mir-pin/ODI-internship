    "la-taverna-rappresentazione-entità.csv": {
        "odi:Representation": {
            "type": "subject_only"
        },
        "odi:represents": {
            "type": "object_property_new_subject",
            "domain": "odi:Representation",
            "range": "odi:Person o odi:Place",
            "note": "il tipo (Person/Place) è dedotto dal suffisso -persona / -luogo dell'id"
        },
        "entityLabel": {
            "type": "label_of_target",
            "target_column": "odi:represents",
            "note": "rdfs:label del target di odi:represents (Person o Place)"
        }
    },

