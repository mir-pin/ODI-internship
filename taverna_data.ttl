    odi:hasMeaningOf bacodi:rinascita-continua-di-venere ;
    odi:hasReferenceMode bacodi:ExplicitReference ;
    odi:hasTextualReference "«vedrà Venere rinascere continuamente sulle rive di Cipro, dissipando le macchie di nafta, la schiuma di detersivo»"^^xsd:string .

bacodi:la-stella-storiaDieci-ofelia-sta-per-annegare a odi:Character ;
    odi:hasIconography bacodi:Grande ;
    odi:hasMeaningOf bacodi:ofelia-che-sta-per-annegare ;
    odi:hasReferenceMode bacodi:ExplicitReference ;
    odi:hasTextualReference "«Ofelia sulla riva d'un ruscello, protesta sulla corrente vitrea e mucillaginosa che tra un'istante l'affogherà»"^^xsd:string .

bacodi:la-stella-storiaDodici-cordelia-esule a odi:Character ;
    odi:hasIconography bacodi:Grande ;
    odi:hasMeaningOf bacodi:cordelia-esule ;
    odi:hasReferenceMode bacodi:ExplicitReference ;
    odi:hasTextualReference "«Senza più asilo né panni per coprirsi s'è rifugiata in queste lande deserte, e beve l'acqua dei fossi»"^^xsd:string .

bacodi:la-stella-storiaTre-cavaliere-rivelato a odi:Character ;
    odi:hasIconography bacodi:Grande ;
    odi:hasMeaningOf bacodi:cavaliere-rivelato ;
    odi:hasReferenceMode bacodi:ExplicitReference ;
    odi:hasTextualReference "«Il guerriero sconosciuto è fermo sulla riva e si sta spogliando dell'armatura» / «ha la pelle di giovinetta, polpe di dama, seno e grembo di regina»"^^xsd:string .

bacodi:la-stella-storiaUndici-protagonista a odi:Character ;
    odi:hasIconography bacodi:Grande ;
    odi:hasMeaningOf bacodi:protagonista ;
    odi:hasReferenceMode bacodi:ExplicitReference ;
    odi:hasTextualReference "«sonnambula che s'alza di notte senza vesti e a occhi chiusi contempla macchie di sangue sulle sue mani e s'affanna in inutili lavacri»"^^xsd:string .

bacodi:la-stella-storiaUno-mare-che-disseta a odi:Symbol ;
    odi:hasIconography bacodi:Grande ;
    odi:hasMeaningOf bacodi:il-mare-che-disseta ;
    odi:hasReferenceMode bacodi:ExplicitReference ;
    odi:hasTextualReference "«la cisterna dove le acque di tutti i pozzi e tutti i fiumi sfociano e si confondono [...] il mare» / «una dea nuda prende due caraffe che contengono chissà quali succhi messi in fresco per chi ha sete [...] e le rovescia a innaffiare la riva di ghiaia»"^^xsd:string .

bacodi:la-temperanza-storiaDodici-cordelia a odi:Character,
        odi:Representation ;
    odi:changesIn bacodi:la-stella-storiaDodici-cordelia-esule ;
    odi:hasMeaningOf bacodi:cordelia ;
    odi:hasReferenceMode bacodi:ExplicitReferenceNoImage ;
    odi:hasTextualReference "«l'angelica Cordelia [...] la figlia da lui incompresa e ingiustamente scacciata»"^^xsd:string .

bacodi:lo-amore-storiaDieci-follia-amore a odi:Symbol ;
    odi:hasIconography bacodi:Grande ;
    odi:hasMeaningOf bacodi:follia-damore ;
    odi:hasReferenceMode bacodi:ExplicitReference ;
    odi:hasTextualReference "«sua madre l'ha sorpreso a delirare per Ofelia: la diagnosi è presto fatta, chiamiamola follia d'amore»"^^xsd:string .

bacodi:lo-eremita-storiaCinque-vita-solitaria a odi:Symbol ;
    odi:hasIconography bacodi:Grande ;
    odi:hasMeaningOf bacodi:vita-solitaria ;
    odi:hasReferenceMode bacodi:ExplicitReference ;
    odi:hasTextualReference "«dubita della sapienza che s'accumula in una solitaria vita d'Eremita»"^^xsd:string .

bacodi:lo-eremita-storiaDodici-protagonista a odi:Character ;
    odi:hasIconography bacodi:Grande ;
    odi:hasMeaningOf bacodi:protagonista ;
    odi:hasReferenceMode bacodi:ExplicitReference ;
    odi:hasTextualReference "«la sua mente ormai albergava solo vento e fulmini e follia» / «le curve spalle rincantucciate non più nel manto d'ermellino ma in un saio da Eremita»"^^xsd:string .

bacodi:lo-eremita-storiaDue-padre a odi:Character ;
    odi:hasIconography bacodi:Piccola ;
    odi:hasMeaningOf bacodi:padre ;
    odi:hasReferenceMode bacodi:ExplicitReference ;
    odi:hasTextualReference "«un padre che, non aspettandosi più niente di buono dal mondo civile, s'era fatto Eremita in questi boschi»"^^xsd:string .

bacodi:lo-eremita-storiaNove-protagonista a odi:Character ;
    odi:hasIconography bacodi:Piccola ;
    odi:hasMeaningOf bacodi:protagonista ;
    odi:hasReferenceMode bacodi:ExplicitReference ;
    odi:hasTextualReference "«Edipo [...] si strappa il lume degli occhi [...] e prende la via di Colono col mantello e il bastone del pellegrino»"^^xsd:string .

bacodi:lo-eremita-storiaTre-eremita a odi:Character ;
    odi:hasIconography bacodi:Grande ;
    odi:hasMeaningOf bacodi:eremita ;
    odi:hasReferenceMode bacodi:ExplicitReference ;
    odi:hasTextualReference "«un Eremita che a lume di lanterna percorre i luoghi della battaglia componendo le spoglie dei morti e medicando le piaghe dei mutilati»"^^xsd:string .

