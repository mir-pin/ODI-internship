    odi:hasTextualReference "«uno spettro somigliante nella barba brizzolata e nell'elmo e corazza splendenti [...] al defunto re di Danimarca»"^^xsd:string .

bacodi:lo-imperatore-storiaDue-imperatore a odi:Character ;
