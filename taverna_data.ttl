bacodi:due-di-spade-storiaDieci-duello a odi:Event ;
    odi:hasIconography bacodi:Grande ;
    odi:hasMeaningOf bacodi:duello ;
    odi:hasReferenceMode bacodi:ExplicitReference ;
    odi:hasTextualReference "«Due Spade s'incrociano in un duello: [...] una è aguzza e l'altra ottusa, l'una è avvelenata e l'altra asettica»"^^xsd:string .

