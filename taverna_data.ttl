bacodi:il-mondo-storiaQuattro-riconciliazione-forze-terrestri-e-celesti a odi:Event ;
    odi:carriedOutBy bacodi:fante-di-coppe-storiaQuattro-cadavere-re-beve,
        bacodi:la-stella-storiaQuattro-regina ;
    odi:hasIconography bacodi:Grande ;
    odi:hasMeaningOf bacodi:riconciliazione-delle-forze-terrestri-e-celesti ;
    odi:hasReferenceMode bacodi:ExplicitReference ;
    odi:hasTextualReference "«Di questo empio rito i tarocchi riportano due versioni [...] l'altra tutta festoni e ghirlande, che celebra la riconciliazione delle forze terrestri con quelle del cielo a simbolo della totalità del Mondo, mediante la danza d'una maga o ninfa ignuda tripudiante»"^^xsd:string .

