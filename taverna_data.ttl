bacodi:cavaliere-di-bastoni-storiaTre-protagonista a odi:Character,
        odi:Representation ;
    odi:changesIn bacodi:il-penduto-storiaTre-protagonista ;
    odi:discovers bacodi:la-stella-storiaTre-cavaliere ;
    odi:hasIconography bacodi:Grande ;
    odi:hasMeaningOf bacodi:protagonista ;
    odi:hasReferenceMode bacodi:ExplicitReference ;
    odi:hasTextualReference "«che attillata uniforme indossava, guernita di lucenti piastre di corazza, con una gardenia alla fibbia d'un gambale» / «i capelli bianchi, l'occhio vaneggiante, la lancia spezzata e ridotta a un troncone. A meno che si trattasse non d'un pezzo di lancia [...] ma d'un foglio di pergamena arrotolato, un messaggio che gli era stato ordinato di recapitare»"^^xsd:string ;
    odi:isDefeatedBy bacodi:il-mondo-storiaTre-guerriera-gigantesca ;
    odi:isHelpedBy bacodi:lo-eremita-storiaTre-eremita ;
