    odi:hasReferenceMode bacodi:ExplicitReference ;
    odi:hasTextualReference "\"«contempla con sguardo ansioso la curva che allaccia il Due di Denari come se scrutasse la traiettoria dalla Terra alla Luna"^^xsd:string .

bacodi:due-di-denari-storiaSette-scrittura-come-scambio a odi:Symbol ;
