    odi:hasMeaningOf bacodi:imperatore ;
    odi:hasReferenceMode bacodi:ExplicitReference ;
    odi:hasTextualReference "«all'Imperatore in persona, che riconoscerà in me la vera sposa del suo erede»"^^xsd:string .

